# ===== 识文新裁 环境变量示例 =====
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，切勿提交）

# 运行环境
APP_ENV=development

# LLM（DeepSeek API）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding（local_bge_m3 = 本地 CPU；api = 走硅基流动 / 智谱等 API）
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3

# PostgreSQL（docker-compose 内建，无需独立账号）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shiwen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiwen

# Milvus Lite（进程内文件模式，S1 起用）
MILVUS_DB_PATH=data/milvus.db

# 语料下载（可选）：覆盖 manifest 的 source_base，国内可配 GitHub raw 镜像
CORPUS_RAW_BASE=

# HuggingFace 镜像（可选）：国内下载 BGE-M3 权重用
HF_ENDPOINT=https://hf-mirror.com
