# ===== 识文新裁 环境变量示例 =====
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，切勿提交）

# 运行环境
APP_ENV=development

# LLM（DeepSeek API）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding（local_bge_m3 = 本地 CPU；api = 硅基流动/智谱等 OpenAI 兼容；cloudflare = Cloudflare Workers AI）
EMBEDDING_PROVIDER=local_bge_m3
# OpenAI 兼容 API（provider=api 时生效）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
# Cloudflare Workers AI（provider=cloudflare 时生效，@cf/baai/bge-m3 = HF BAAI/bge-m3 同款 1024 维）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# PostgreSQL（docker-compose 内建，无需独立账号）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shiwen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiwen

# Milvus Lite（进程内文件模式，S1 起用）
MILVUS_DB_PATH=data/milvus.db

# 语料下载（可选）：覆盖 manifest 的 source_base，国内可配 GitHub raw 镜像
CORPUS_RAW_BASE=

# HuggingFace 端点：hf-mirror 对 huggingface_hub 新版返回 308 到非 HF 域被拒，
# 用官方端点最稳（模型权重下载一次后缓存在 hf_cache 卷，之后离线可用）
HF_ENDPOINT=https://huggingface.co
