# ===== 环境与密钥（切勿提交）=====
.env
.env.*
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 数据（大语料不进 git，仅保留占位）=====
data/corpus/*
!data/corpus/.gitkeep
# 语料清单与人物关系表进 git（注意：gitignore 否定行不能带行内注释）
!data/corpus/manifest.yaml
!data/corpus/people.yaml
data/milvus.db
data/*.db

# ===== 评测产物（由评测脚本生成）=====
eval/report.md
eval/results.json
eval/report_debate.md
eval/debate_results.json
eval/report_writing.md
eval/writing_results.json

# ===== 前端 =====
node_modules/
frontend/dist/
frontend/.vite/

# ===== Claude Code（本地配置，不进仓库）=====
.claude/

# ===== IDE / OS =====
.idea/
.vscode/
.DS_Store
Thumbs.db
